<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (docs/spec.md §6.3).
  - Cloud backup: nothing. Every domain is excluded, so no copy of the vehicle logs ever leaves the phone through
    Google's backup. Users keep their own copy with Settings > Backup file (.wheelfile).
  - Device-to-device transfer (phone to phone): the Room database, the private attachment files and the DataStore
    settings are copied, so a new phone starts with the same vehicles, logs and attachments. Firebase and ads
    caches are not copied; they are rebuilt on the new phone.
  An <include> list means "only these": shared preferences (ads and Firebase state), the root and external domains
  and every other file are therefore left behind. The explicit excludes name the Firebase databases inside the
  included database folder.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="attachments" />
        <include domain="file" path="datastore" />
        <exclude domain="database" path="google_app_measurement.db" />
        <exclude domain="database" path="google_app_measurement_local.db" />
        <exclude domain="database" path="com.google.android.datatransport.events" />
    </device-transfer>
</data-extraction-rules>
