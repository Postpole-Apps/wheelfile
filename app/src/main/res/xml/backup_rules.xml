<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older, and the default for API 26-27 (docs/spec.md §6.3): exclude everything.
  API 28-30 use res/xml-v28/backup_rules.xml, which adds the device-to-device transfer includes.
  Android 12+ reads data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
