<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Ad ID collection is intentionally kept ON (needed for Google Ads conversion tracking via
      Firebase Analytics). Do not add tools:node="remove" for AD_ID / ADSERVICES permissions.
      Declare "Advertising ID" usage in Play Console's Data safety / App content.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Asked in context when the first reminder is saved (Android 13+). Reminders still show in the app if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      WorkManager's library manifest adds FOREGROUND_SERVICE for its optional setForeground() support. Reminders run as
      plain periodic and one-time work and never start a foreground service, so the permission is removed: no
      foreground-service type and no Play Console foreground-service declaration are needed (docs/merged-manifest.md).
      The unused SystemForegroundService entry stays; without the permission it can never be started.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <!--
      Deliberately absent: CAMERA (photos use the TakePicture intent), READ_MEDIA_* / storage (Photo Picker and the
      document picker hand over a readable URI), location and exact alarms. ManifestPermissionsTest enforces this.
    -->

    <application
        android:name=".WheelfileApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wheelfile">
        <!-- AdMob App ID, injected via manifestPlaceholders["admobAppId"] (docs/admob.md). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- WorkManager starts on demand through WheelfileApp (Configuration.Provider). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Camera captures (cache) and attachment files, shared by URI only. No storage permission needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Wheelfile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
